# Copy to .env and fill in. .env is git-ignored. NEVER commit real credentials.
# This system is PAPER TRADING ONLY: broker keys are used for MARKET DATA ONLY.

# ---- Storage -------------------------------------------------------------------------
# Default: SQLite file in runtime/. PostgreSQL example: postgresql+psycopg://user:pass@localhost/liar
# DATABASE_URL=sqlite:///D:/Liar-V1/runtime/trading.db

# ---- Email alerts (Gmail App Password: Google Account > Security > 2-Step Verification > App passwords)
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
ALERT_EMAIL_TO=you@gmail.com

# ---- Angel One SmartAPI (free market data) - https://smartapi.angelbroking.com ----------
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# ---- Upstox (alternative market data) - https://upstox.com/developer/api-documentation --
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=

# ---- Dashboard ------------------------------------------------------------------------
# Credentials are created with:  python scripts/set_password.py   (bcrypt hash in secrets/)
DASHBOARD_AUTH_FILE=secrets/dashboard_auth.yaml
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501

# ---- Network --------------------------------------------------------------------------
# Corporate proxy / antivirus HTTPS scanning: point to a PEM bundle if the automatic
# Windows-cert-store bundle (engine.use_os_cert_store) is not enough.
# CA_BUNDLE_PATH=

# ---- LLM ------------------------------------------------------------------------------
# OLLAMA_HOST=http://127.0.0.1:11434
