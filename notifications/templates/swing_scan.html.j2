{% extends "_base.html.j2" %}
{% import "_macros.html.j2" as m %}
{% block content %}
{% if candidates %}
<p style="margin:0 0 8px 0;color:#52514e;">{{ candidates|length }} candidate{{ "s" if candidates|length != 1 else "" }} for the next session. Levels are deterministic (Python); entries still pass the risk manager and, where the mode requires it, your approval in the dashboard.</p>
{% for c in candidates %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:separate;margin:10px 0;border:1px solid #e2e1dc;border-radius:6px;">
  <tr>
    <td style="padding:10px 12px;background:#f7f7f5;border-radius:6px 6px 0 0;">
      <span style="font-size:16px;font-weight:700;color:#0b0b0b;">{{ loop.index }}. {{ c.symbol }}</span>
      <span style="font-size:12px;color:#52514e;"> &middot; {{ c.mode }} &middot; {{ c.side }}{% if c.grade %} &middot; grade {{ c.grade }}{% endif %}{% if c.confidence is not none %} &middot; conf {{ c.confidence|num(0) }}{% endif %}</span>
    </td>
  </tr>
  <tr>
    <td style="padding:8px 12px;">
      {{ m.kv([
        ("Entry", c.entry|price),
        ("Stop-loss", (c.stop_loss|price) ~ ((" (" ~ (c.sl_pct|pct) ~ ")") if c.sl_pct is not none else ""), COLOR_NEG),
        ("Target 1 / 2", (c.target_1|price) ~ " / " ~ (c.target_2|price), COLOR_POS),
        ("Reward : risk (T1)", c.rr|num),
        ("Strategy", c.strategy or DASH),
        ("Confluence", c.confluence|num(0)),
      ]) }}
      {% if c.notes %}<p style="margin:6px 0 0 0;font-size:13px;color:#52514e;">{{ c.notes }}</p>{% endif %}
    </td>
  </tr>
</table>
{% endfor %}
{% else %}
{{ m.note("The evening scan found no candidates that passed the filters for the next session.", 'info') }}
{% endif %}
{% endblock %}
